{
  "name": "@mariozechner/jot",
  "version": "0.1.2",
  "bin": {
    "jot": "dist/cli/jot.mjs"
  },
  "files": [
    "dist"
  ],
  "description": "Minimal self-hosted markdown editor with inline comment threads",
  "scripts": {
    "dev": "npm run build:client && (tsc -p client --watch --preserveWatchOutput & tsx watch server/server.ts)",
    "build": "npm run build:server && npm run build:client && npm run build:cli",
    "build:server": "tsc -p server",
    "build:client": "tsc -p client && node -e \"require('fs').copyFileSync('client/styles.css', 'dist/public/styles.css')\"",
    "build:cli": "tsc -p cli",
    "start": "node dist/server/server.js",
    "test": "npm run test:unit && npm run test:convergence && npm run test:protocol",
    "test:unit": "vitest run tests/unit",
    "test:convergence": "tsx tests/convergence/harness.mts",
    "pretest:protocol": "npm run build:client",
    "test:protocol": "vitest run tests/protocol",
    "pretest:e2e": "npm run build:client",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "articulated": "^1.3.1",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.1",
    "mermaid": "^11.14.0",
    "sanitize-html": "^2.17.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
